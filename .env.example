NODE_ENV=development
PORT=3000

# MongoDB
MONGO_URI=mongodb://localhost:27017/oficina_erp

# Segredos de autenticação (gere valores longos e aleatórios em produção)
JWT_SECRET=troque-por-um-valor-aleatorio-longo
JWT_EXPIRES_IN=8h
SESSION_SECRET=troque-por-outro-valor-aleatorio-longo

# Painel do dono do sistema (duas camadas de proteção, nenhuma delas
# aparece no código-fonte nem em links da aplicação):
#  - ADMIN_PATH: o caminho da URL, ex: /minha-url-secreta-123
#  - ADMIN_SECRET: a senha pedida nessa URL
# Se não definir, o sistema gera valores temporários e imprime no console a
# cada reinício (só serve para desenvolvimento).
ADMIN_PATH=minha-url-secreta-123
ADMIN_SECRET=troque-por-uma-senha-bem-forte-e-so-sua

APP_URL=http://localhost:3000

# E-mail (opcional, usado para recuperação de senha)
RESEND_API_KEY=
RESEND_FROM=Oficina ERP <onboarding@resend.dev>

# WhatsApp (opcional)
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=

# Busca de veículo por placa (opcional). Não existe API oficial e gratuita
# do governo para isso — é sempre um provedor terceirizado. Este sistema
# está configurado para a APIBrasil (paga, ~R$ 0,10/consulta, sem faixa
# gratuita confirmada na tela oficial de preços):
#   1. Crie conta em https://app.apibrasil.io
#   2. Contrate a API de placa desejada no Marketplace
#   3. Pegue o Bearer Token em "Credenciais"
#   4. Confira na tela "Detalhes" da SUA API contratada (botão "Detalhes"
#      no card dela) se o exemplo de código pede também um DeviceToken.
#      Se pedir, crie um dispositivo em "Integrações" > "Novo Dispositivo"
#      e cole o token gerado abaixo. Se não pedir (só Authorization:
#      Bearer no exemplo), deixe PLACA_API_DEVICE_TOKEN em branco.
PLACA_API_PROVEDOR=apibrasil
PLACA_API_BEARER_TOKEN=
PLACA_API_DEVICE_TOKEN=
# Tenta rodar em modo sandbox sem cobrar, se o provedor suportar isso na
# rota usada. Deixe true pra testar, mude pra false quando for pra valer.
PLACA_API_HOMOLOG=false

# Data em que o token acima foi configurado/trocado pela última vez
# (AAAA-MM-DD). Usada só para o lembrete de rotação de credenciais a cada
# 90 dias (ver utils/verificacaoCredenciais.js) — atualize sempre que
# trocar o token. Sem essa data, o sistema não consegue calcular a idade
# do token e não envia o lembrete.
PLACA_API_TOKEN_DEFINIDO_EM=

# Por quantos dias o resultado de cada placa fica em cache (Mongo, com
# expiração automática) antes de consultar a API de novo. Economiza
# requisições/dinheiro em placas repetidas.
PLACA_API_CACHE_DIAS=30

# Alternativa de TESTE (PLACA_API_PROVEDOR=sinesp-local): aponta para uma
# instância local do projeto consultaplaca-api
# (github.com/yagoluiz/consultaplaca-api) — usa uma via NÃO OFICIAL
# (engenharia reversa do app Sinesp Cidadão), sem garantia de
# funcionamento. Não recomendado para produção. Para rodar sem Docker:
#   git clone https://github.com/yagoluiz/consultaplaca-api.git
#   cd consultaplaca-api && npm install
#   PORT=3001 npm start
PLACA_API_URL_LOCAL=http://localhost:3001

# Sem nenhuma dessas variáveis configuradas, o campo continua sendo
# preenchido manualmente, como sempre foi.

# Alerta por e-mail (opcional, mas recomendado se usar a busca por placa).
# Se a integração acima cair (fora do ar, token expirado etc.), um e-mail
# é enviado para o endereço abaixo avisando do problema — no máximo 1 a
# cada 30 minutos, para não lotar a caixa de entrada. Usa o mesmo Resend
# configurado acima (RESEND_API_KEY); sem essa chave, o alerta não é
# enviado, mas o sistema continua funcionando normalmente.
ALERTA_EMAIL_DESTINO=vitorguiljerme1@gmail.com

MAX_FILE_SIZE_MB=5
